# LLM
GEMINI_API_KEY=
GEMINI_MODEL=            # ajustar para o modelo Flash gratuito vigente (padrão: gemini-3.6-flash; se der 404 o backend escolhe sozinho um Flash disponível)
GROQ_API_KEY=
GROQ_MODEL=              # padrão: llama-3.3-70b-versatile
LLM_PROVIDER=gemini      # gemini | groq | mock
# TTS
TTS_PROVIDER=edge        # edge | mock
VOICE_HOST_1=pt-BR-AntonioNeural
VOICE_HOST_2=pt-BR-FranciscaNeural
# Mocks (dev sem chaves)
MOCK_LLM=0
MOCK_TTS=0
# Servidor
ALLOWED_ORIGINS=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173/
DATA_DIR=./.data
EPISODE_TTL_HOURS=24
MAX_CONCURRENT_RENDERS=2
# Frontend (apps/web/.env.local)
VITE_API_URL=http://localhost:8000
